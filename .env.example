# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Gemini (primary). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (fallback provider). Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Semantic Scholar (optional, raises rate limits): https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex and Crossref want a contact email in the User-Agent -- it buys you a
# faster rate-limit pool. No signup needed.
CONTACT_EMAIL=

# Storage
DATABASE_URL=sqlite:///./research.db
LLM_CACHE_DIR=./llm_cache
